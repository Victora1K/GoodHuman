# Shared
NODE_ENV=development
DATABASE_URL=postgresql://goodhuman:goodhuman@localhost:5432/goodhuman
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-change-me-goodhuman-jwt-secret
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CDN_PUBLIC_URL=http://localhost:4000/public

# Object storage (local filesystem adapter by default)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
# S3-compatible (optional)
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=goodhuman
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=minio123
# S3_FORCE_PATH_STYLE=true

# Config (no magic numbers in UI)
BOOKING_FEE_FREE=0.08
BOOKING_FEE_PREMIUM=0.04
PREMIUM_PRICE_MONTHLY_CENTS=2900
DEPOSIT_DEFAULT=0.5
PAYOUT_DELAY_HOURS=24
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=209715200
MAX_AUDIO_BYTES=31457280
SIGNED_URL_TTL_SECONDS=300
